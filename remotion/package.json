{
  "name": "peugeot408-remotion",
  "private": true,
  "description": "Remotion assets for the DashCraft app (app icon, previews, videos).",
  "scripts": {
    "studio": "remotion studio",
    "icon": "node scripts/render-icon.mjs",
    "store": "node scripts/render-store.mjs",
    "header": "remotion still StoreHeader out/store-header.png --image-format=png",
    "check-icon": "node scripts/check-icon-alpha.mjs out/AppIcon-1024.png",
    "typecheck": "tsc --noEmit",
    "videos": "node scripts/render-videos.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/studio": "4.0.540",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "pngjs": "7.0.0",
    "typescript": "5.9.2"
  }
}
